import { imageSize } from 'image-size';
import { createHash } from 'node:crypto';
import {
  mkdirSync,
  readFileSync,
  readdirSync,
  rmSync,
  writeFileSync,
} from 'node:fs';
import { extname, join } from 'node:path';

export const GENERATED_IMAGES = 'public/_content-images';
interface ImageMetadata {
  width: number;
  height: number;
  immutableSrc?: string;
}

function dimensions(bytes: Buffer): ImageMetadata | undefined {
  try {
    const { width, height } = imageSize(bytes);
    return width > 0 && height > 0 ? { width, height } : undefined;
  } catch {
    return undefined;
  }
}

/** Only this generated directory carries immutable URLs; authored files remain mutable. */
export function generatePublicImages(root: string) {
  const metadata: Record<string, ImageMetadata> = {};
  const output = join(root, GENERATED_IMAGES);
  const retained = new Set(['.keep']);
  mkdirSync(output, { recursive: true });
  writeFileSync(join(output, '.keep'), 'Generated by content preparation.\n');
  function visit(directory: string) {
    for (const entry of readdirSync(join(root, 'public', directory), {
      withFileTypes: true,
    })) {
      const path = join(directory, entry.name);
      if (path === '_content-images') continue;
      if (entry.isDirectory()) visit(path);
      else if (
        entry.isFile() &&
        /\.(?:png|jpe?g|webp|gif|avif|svg)$/i.test(path)
      ) {
        const bytes = readFileSync(join(root, 'public', path));
        const image = dimensions(bytes);
        if (!image) continue;
        if (
          path.startsWith('assets/') &&
          /\.(?:png|jpe?g|webp|avif)$/i.test(path)
        ) {
          const file =
            createHash('sha256').update(bytes).digest('hex') +
            extname(path).toLowerCase();
          image.immutableSrc = '/_content-images/' + file;
          writeFileSync(join(output, file), bytes);
          retained.add(file);
        }
        metadata['/' + path] = image;
      }
    }
  }
  visit('');
  for (const name of readdirSync(output)) {
    if (!retained.has(name)) rmSync(join(output, name), { recursive: true });
  }
  return metadata;
}

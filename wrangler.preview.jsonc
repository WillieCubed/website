{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "18f90fa11cf0a87145be4a1517e41217",
  "name": "willie-page-preview",
  "main": ".open-next/worker.js",
  "base_dir": ".open-next",
  "find_additional_modules": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "content/**/*.md",
        "content/**/*.mdx",
        "public/search-index.json",
      ],
      "fallthrough": true,
    },
    { "type": "Data", "globs": ["brand/fonts/**/*.ttf"], "fallthrough": true },
  ],
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "SITE_MODE": "preview",
    "STUDIO_ORIGIN": "https://preview.willie.page",
    "STUDIO_PUBLIC_ORIGIN": "https://willie.page",
    "STUDIO_GITHUB_REPOSITORY": "WillieCubed/website",
    "STUDIO_GITHUB_BRANCH": "main",
    "STUDIO_LATTICE_ISSUER": "https://auth.uselovelace.com",
    "STUDIO_LATTICE_CLIENT_ID": "https://willie.page/.well-known/lattice-client.json",
    "STUDIO_LATTICE_GATEWAY": "https://lattice.uselovelace.com",
    "ATPROTO_PUBLICATION_RKEY": "3mwxne5td6lid",
  },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "willie-page-preview" },
  ],
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "0b5d616d4c994fa5ac27afcea7ddfdaf" },
    {
      "binding": "STUDIO_HYPERDRIVE",
      "id": "fdf7a90c3fbc4392b35d5fdaf29bce85",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "willie-page-preview-cache",
    },
    { "binding": "MEDIA_BUCKET", "bucket_name": "willie-page-preview-media" },
    {
      "binding": "STUDIO_PRIVATE_BUCKET",
      "bucket_name": "willie-page-studio-private",
    },
    {
      "binding": "STUDIO_PUBLIC_MEDIA_BUCKET",
      "bucket_name": "willie-page-media",
    },
  ],
  "ratelimits": [
    {
      "name": "WEBMENTION_EDGE_LIMIT",
      "namespace_id": "66131002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
}

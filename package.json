    "postcss": "^8.5.28",
    "prettier": "^3.8.3",
    "sharp": "^0.35.5",
    "svg-to-pdfkit": "0.1.8",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1",
    "wrangler": "4.149.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": "eslint --fix --max-warnings 0 --no-warn-ignored",
    "*.{js,jsx,ts,tsx,mjs,mts,css,md}": "prettier --write"

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "willie-page",
  "main": ".open-next/worker.js",
  "base_dir": ".open-next",
  "find_additional_modules": true,
  "rules": [
    { "type": "Text", "globs": ["content/**/*.md", "content/**/*.mdx", "public/search-index.json"], "fallthrough": true },
    { "type": "Data", "globs": ["brand/fonts/**/*.ttf"], "fallthrough": true }
  ],
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "ATPROTO_PUBLICATION_RKEY": "3mwxne5td6lid",
    "MICROPUB_GITHUB_REPO": "WillieCubed/website",
    "MICROPUB_GITHUB_BRANCH": "main"
  },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "willie-page" }
  ],
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "22d2802570684a09a567d3f41c3f5ff1" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "willie-page-cache" },
    { "binding": "MEDIA_BUCKET", "bucket_name": "willie-page-media" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }
  ],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}

// Serves the static homepage and brand page on willie.page while the Next.js
// site is rebuilt. Deploy with `pnpm deploy:willie-page`.
{
  "name": "willie-page",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./site", "not_found_handling": "404-page", "html_handling": "drop-trailing-slash" },
  "routes": [
    { "pattern": "willie.page/*", "zone_name": "willie.page" },
    { "pattern": "www.willie.page/*", "zone_name": "willie.page" }
  ]
}

# Copy this file to .env.local and fill in what you need. Every value here is
# safe to leave as is: the site builds and serves with none of them set, and
# each feature below turns itself off or falls back when its variable is empty.
# The IndieWeb variables are described in docs/indieweb/README.md.

# Set this on isolated deployments so generated permalinks and feeds use their
# own public origin. Production defaults to https://willie.page when empty.
NEXT_PUBLIC_SITE_ORIGIN=

# --- Database ----------------------------------------------------------------

# Postgres connection string for webmentions, reply context, activity feeds,
# and Postgres search. Empty turns those features off; pages still render.
POSTGRES_URL=
# Accepted in place of POSTGRES_URL by the search and webmention-sending
# checks, but the Postgres driver itself connects with POSTGRES_URL, so set
# that one.
DATABASE_URL=

# --- Webmentions -------------------------------------------------------------

# Bearer token for POST /api/webmention/send and /api/webmention/send-all.
# Empty makes both routes answer 503.
WEBMENTION_SECRET=
# Bearer token for /api/webmention/moderate, which lists pending webmentions
# and approves or rejects them. Empty makes the route answer 503.
WEBMENTION_MODERATION_SECRET=
# Set to true to make `pnpm webmentions:send` exit without sending anything.
SKIP_WEBMENTIONS=
# Set to 1 to ping the WebSub hub and send webmentions after `pnpm build`.
# Anything else skips both, so local and preview builds never notify anyone.
INDIEWEB_POSTBUILD=

# --- IndieAuth ---------------------------------------------------------------

# The site runs its own IndieAuth server under /indieauth, and Micropub checks
# its tokens against the same database, so both need POSTGRES_URL.
# Base32 TOTP secret the owner's authenticator app holds; the consent page asks
# for its current code before approving a sign-in. Make one with
# `pnpm indieauth:totp`. Empty turns sign-in off: the consent page answers 503
# and no new tokens are issued. Never commit a real value.
INDIEAUTH_TOTP_SECRET=
# Bearer secret for POST /indieauth/introspect, for resource servers that
# check this site's tokens. Empty makes the endpoint answer 503.
INDIEAUTH_INTROSPECTION_SECRET=

# --- Micropub ----------------------------------------------------------------

# GitHub repository (owner/name) and token that Micropub commits new posts to.
# With either one empty, posts are written to MICROPUB_CONTENT_PATH on disk.
MICROPUB_GITHUB_REPO=
MICROPUB_GITHUB_TOKEN=
# Branch that Micropub commits to.
MICROPUB_GITHUB_BRANCH=main
# Directory, relative to the repository root, that new posts are written to.
MICROPUB_CONTENT_PATH=content/writings
# Vercel Blob read-write token for the Micropub media endpoint, which stores
# uploaded photos as public blobs. Empty makes /micropub/media answer 503, so
# clients cannot upload photos.
BLOB_READ_WRITE_TOKEN=

# --- Search ------------------------------------------------------------------

# Set to postgres to answer search from Postgres (needs POSTGRES_URL). Anything
# else uses the JSON index that the prebuild script writes.
SEARCH_BACKEND=
# Bearer token for POST /api/search/reindex, checked only in production. Empty
# leaves the route open, so set it before turning on Postgres search there.
SEARCH_REINDEX_SECRET=

# --- Email --------------------------------------------------------------------

# The addresses the site prints. Empty uses hello@willie.page and
# projects@willie.page (lib/site.ts). Every mailto link, the footer, the
# palette, security.txt, feeds, and IndieAuth profiles read these.
NEXT_PUBLIC_EMAIL_HELLO=
NEXT_PUBLIC_EMAIL_PROJECTS=

# --- AT Protocol -----------------------------------------------------------------

# The site owner's AT Protocol DID (did:plc:...). /.well-known/atproto-did serves
# it, and the Bluesky account is linked and offered as a Micropub syndication
# target by DID, so links survive a handle change. Empty turns all of that off:
# the route answers 404 and there is no Bluesky account.
NEXT_PUBLIC_ATPROTO_DID=
# The Bluesky handle shown beside that account. Empty shows the DID instead.
NEXT_PUBLIC_BLUESKY_HANDLE=
# The standard.site publication's record key: a TID generated once (see
# docs/atproto.md) and never changed, because every page names the record by
# it. Empty leaves out the publication, its <link> tags, and the sync.
ATPROTO_PUBLICATION_RKEY=
# App password for the account behind NEXT_PUBLIC_ATPROTO_DID (Bluesky
# Settings > Privacy and security > App passwords). The post-deploy sync writes
# the standard.site records with it. Set it on Production only. Empty skips the
# sync. Never commit a real value.
ATPROTO_APP_PASSWORD=

# --- Analytics ---------------------------------------------------------------

# Google Analytics measurement ID, such as G-XXXXXXXXXX. The tag loads only in
# production builds and only when this is set.
NEXT_PUBLIC_GTAG_ID=

# Confidential OAuth client keys for Standard.site subscriptions and recommends.
# Both stay on the server and must be sensitive Vercel variables. See docs/atproto.md.
ATPROTO_OAUTH_JWK=
ATPROTO_OAUTH_STORAGE_KEY=

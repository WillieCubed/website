import assert from 'node:assert/strict';
import { execFile } from 'node:child_process';
import { mkdtemp, readFile, readdir, rm } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import test from 'node:test';
import { promisify } from 'node:util';

import { buildPagefindIndex } from '@/lib/search/pagefind';
import type { SearchableItem } from '@/lib/search/types';

const item: SearchableItem = {
  slug: 'journal',
  path: '/writings/journal',
  title: 'Journal',
  description: 'A test writing',
  content: 'Journal text',
  tags: [],
  published: '2026-01-01T00:00:00Z',
  type: 'writing',
};

test('the pinned Pagefind adapter exports complete bytes under Node', async () => {
  const code = `import * as pagefind from 'pagefind'; const { index } = await pagefind.createIndex(); try { await index.addCustomRecord({url:'/journal', content:'journal', language:'en'}); const { files, errors } = await index.getFiles(); if(errors.length || !files.length || files.some(f => !f.content.byteLength)) throw new Error('Incomplete search artifacts'); console.log('complete'); } finally { await pagefind.close(); }`;
  const { stdout } = await promisify(execFile)(
    process.execPath,
    ['--input-type=module', '--eval', code],
    { timeout: 15_000 }
  );
  assert.equal(stdout.trim(), 'complete');
});

test('search generation returns only after every browser asset is fully written', async () => {
  const directory = await mkdtemp(join(tmpdir(), 'search-artifacts-'));
  try {
    for (let run = 0; run < 3; run++) {
      const output = join(directory, String(run));
      await buildPagefindIndex([item], output);
      const names = await readdir(output);
      assert(names.some((name) => /^wasm\..*\.pagefind$/.test(name)));
      for (const name of names.filter((name) =>
        /\.(js|css|json|pagefind)$/.test(name)
      )) {
        const bytes = await readFile(join(output, name));
        assert(
          bytes.length > 0,
          `Search asset ${name} must be complete when the build returns.`
        );
      }
      const entry = JSON.parse(
        await readFile(join(output, 'pagefind-entry.json'), 'utf8')
      );
      assert.equal(typeof entry.languages.en.hash, 'string');
      assert.match(
        await readFile(join(output, 'pagefind.js'), 'utf8'),
        /export/
      );
    }
  } finally {
    await rm(directory, { recursive: true, force: true });
  }
});

test('generated bytes are persisted before the search backend is closed', async () => {
  const directory = await mkdtemp(join(tmpdir(), 'search-write-order-'));
  let closed = false;
  const bytes = Buffer.from('export const search = () => "journal";');
  const backend = {
    async createIndex() {
      return {
        errors: [],
        index: {
          async addCustomRecord() {
            return { errors: [] };
          },
          async getFiles() {
            return {
              errors: [],
              files: [{ path: 'pagefind.js', content: bytes }],
            };
          },
        },
      };
    },
    async close() {
      assert.deepEqual(await readFile(join(directory, 'pagefind.js')), bytes);
      closed = true;
    },
  };
  try {
    await buildPagefindIndex([item], directory, async () => backend);
    assert.equal(closed, true);
    assert.deepEqual(await readFile(join(directory, 'pagefind.js')), bytes);
  } finally {
    await rm(directory, { recursive: true, force: true });
  }
});

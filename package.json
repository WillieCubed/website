{
  "name": "website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "PORTLESS_PORT=1355 portless",
    "dev:app": "next dev",
    "predev:app": "tsx scripts/studio/build-runtime.mts && tsx scripts/cloudflare/generate-mdx.mts && tsx scripts/search/generate-index.mts && tsx scripts/cloudflare/generate-content-manifest.mts",
    "prebuild": "tsx scripts/studio/build-runtime.mts && pnpm content:check && tsx scripts/cloudflare/generate-mdx.mts && tsx scripts/search/generate-index.mts && tsx scripts/cloudflare/generate-content-manifest.mts",
    "build": "next build",
    "build:cloudflare": "tsx scripts/cloudflare/build.mts",
    "build:cloudflare-preview": "tsx scripts/cloudflare/build.mts preview",
    "build:metrics": "tsx scripts/cloudflare/build-metrics.mts",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "preview:metrics": "tsx scripts/cloudflare/preview-metrics.mts",
    "deploy:cloudflare": "tsx scripts/cloudflare/deploy.mts",
    "deploy:cloudflare-preview": "tsx scripts/cloudflare/deploy.mts preview",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && pnpm spacing:check",
    "spacing:check": "tsx scripts/design/check-spacing.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "pretypecheck": "tsx scripts/cloudflare/generate-mdx.mts",
    "check": "pnpm test && pnpm lint && pnpm typecheck && pnpm build",
    "content:check": "tsx scripts/content/check-images.mts",
    "media:fetch": "tsx scripts/media/fetch.mts fetch",
    "format": "prettier --write .",
    "brand:build": "node brand/build.mjs",
    "prepare": "husky",
    "brand:seeds": "node brand/resolve-brands.mjs",
    "test": "tsx --env-file=tests/unit/test.env --test --test-concurrency=2 'tests/unit/**/*.test.mts'",
    "test:e2e": "playwright test",
    "search:index": "tsx scripts/search/generate-index.mts",
    "websub:ping": "tsx scripts/indieweb/websub/ping.mts",
    "webmentions:send": "tsx scripts/indieweb/webmention/send.mts",
    "webmentions:moderate": "tsx scripts/indieweb/webmention/moderate.mts",
    "webmentions:backfill-authors": "tsx scripts/indieweb/webmention/backfill-authors.mts",
    "atproto:sync": "tsx --env-file-if-exists=.env.atproto.local scripts/atproto/sync.mts",
    "media:discover": "tsx scripts/media/fetch.mts discover",
    "studio:migrate": "tsx scripts/studio/migrate.mts",
    "studio:import": "tsx scripts/studio/import-drafts.mts",
    "test:studio": "tsx scripts/studio/build-runtime.mts && tsx tests/support/studio/run.mts",
    "pretest": "tsx scripts/studio/build-runtime.mts && tsx scripts/cloudflare/generate-mdx.mts"
  },

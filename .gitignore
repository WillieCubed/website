# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
next-env.d.ts
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# ESLint
.eslintcache
.env*.local

# Build cache
.cache/

# Generated by the prebuild script (scripts/generate-search-index.ts)
/public/search-index.json
/public/pagefind/

# Browser automation output (Playwright MCP screenshots, logs, snapshots)
/.playwright-mcp/

# Playwright smoke test output (tests/e2e)
/test-results/
/playwright-report/
